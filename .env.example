# Local defaults. Copy to .env; never commit .env.
SENTRICODE_DATA_DIR=./data
SENTRICODE_PUBLIC_URL=http://127.0.0.1:8000
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(36))"
# Required (at least 24 characters) in Docker or when publishing;
# optional only for direct local runs on loopback.
SENTRICODE_TOKEN=
SENTRICODE_ALLOWED_ORIGINS=
SENTRICODE_EMBEDDED_WORKER=true

# Default: local SQLite. For an existing PostgreSQL server, use:
# SENTRICODE_DATABASE_URL=postgresql+psycopg://user:password@host:5432/sentricode
SENTRICODE_DATABASE_URL=

# Allows per-scan opt-in OSV/EPSS/KEV requests. No source code is sent.
SENTRICODE_NETWORK_ENABLED=false
SENTRICODE_MAX_UPLOAD_MB=25
SENTRICODE_MAX_EXTRACTED_MB=100
SENTRICODE_MAX_FILES=10000

# Optional private-repository access. Use a narrowly scoped read-only token.
SENTRICODE_GITHUB_TOKEN=
# Optional GitHub OAuth owner sign-in. These three values and SENTRICODE_TOKEN
# are needed. Import tokens and OAuth have separate purposes.
SENTRICODE_GITHUB_CLIENT_ID=
SENTRICODE_GITHUB_CLIENT_SECRET=
SENTRICODE_GITHUB_OWNER=

# Optional AI explanations. Requests require explicit consent in the UI.
OPENAI_API_KEY=
SENTRICODE_AI_MODEL=gpt-5-mini

# Used only by compose.production.yaml / Caddy. Set your real hostname.
SENTRICODE_DOMAIN=
